<Window x:Class="DianXu.SelectionOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="#260F1B32" Topmost="True" ShowInTaskbar="False" Cursor="Cross" KeyDown="OverlayKeyDown">
 <Canvas x:Name="Surface" ClipToBounds="True">
  <Line x:Name="HorizontalLine" Stroke="#B6CAFF" StrokeThickness="1" Opacity="0.75"/>
  <Line x:Name="VerticalLine" Stroke="#B6CAFF" StrokeThickness="1" Opacity="0.75"/>
  <Border x:Name="PositionCard" Background="#F2202C40" CornerRadius="11" Padding="17,13" IsHitTestVisible="False">
   <StackPanel><TextBlock Text="选择点击位置" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CoordinateText" Foreground="#C9D8FF" FontFamily="Consolas" FontSize="14" Margin="0,6,0,7"/><TextBlock Text="左键确认 · 右键 / Esc 取消" Foreground="#C4CEDF" FontSize="11"/></StackPanel>
  </Border>
 </Canvas>
</Window>
