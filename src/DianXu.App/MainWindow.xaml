<Window x:Class="DianXu.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}"
 Title="点序 · 屏幕连点器" Icon="Assets/DianXu.ico" Width="1000" Height="790" MinWidth="840" MinHeight="650" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Margin="28,22,28,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="210"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <StackPanel Orientation="Horizontal">
    <Border Background="{StaticResource Accent}" CornerRadius="13" Width="48" Height="48" Margin="0,0,14,0">
     <Viewbox Margin="12"><Canvas Width="26" Height="28"><Path Fill="White" Data="M 3,1 L 3,24 L 9,18 L 14,27 L 19,24 L 14,16 L 23,16 Z"/><Ellipse Fill="#FFD893" Width="7" Height="7" Canvas.Left="19" Canvas.Top="1"/></Canvas></Viewbox>
    </Border>
    <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="点序" FontSize="25" FontWeight="Bold"/><TextBlock Text="屏幕连点器" FontSize="13" Foreground="{StaticResource Muted}" Margin="12,10,0,0"/></StackPanel><TextBlock Text="设置位置，让重复点击有条不紊。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
   </StackPanel>
   <Border x:Name="StateBadge" Background="#EAF4EF" CornerRadius="16" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="13,7">
    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#39996F" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="StateText" Text="已就绪" Foreground="#328365" FontSize="12"/></StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="20,17,20,15"><StackPanel Orientation="Horizontal"><TextBlock Text="点击顺序" FontSize="16" FontWeight="SemiBold"/><Border Background="#F0F3F8" CornerRadius="5" Padding="7,2" Margin="10,0,0,0"><TextBlock x:Name="PointCountText" Text="0 个位置" FontSize="11" Foreground="#7A8495" VerticalAlignment="Center"/></Border></StackPanel><TextBlock HorizontalAlignment="Right" Text="依次点击 · 循环执行" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1" Margin="20,0,20,15" x:Name="PointToolbar">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="AddButton" Content="＋  添加位置" Style="{StaticResource PrimaryButton}" Click="AddPointClick" Margin="0,0,8,0"/>
      <Button x:Name="EditButton" Content="编辑" Click="EditPointClick" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="UpButton" Content="↑" ToolTip="上移" AutomationProperties.Name="上移" Width="38" Padding="0" Click="MoveUpClick" Margin="0,0,6,0" IsEnabled="False"/>
      <Button x:Name="DownButton" Content="↓" ToolTip="下移" AutomationProperties.Name="下移" Width="38" Padding="0" Click="MoveDownClick" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}" Click="DeletePointClick" IsEnabled="False"/>
     </StackPanel>
     <TextBlock Text="双击列表项可编辑" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="2" MinHeight="110">
     <DataGrid x:Name="PointGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowHeight="49" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="PointSelectionChanged" MouseDoubleClick="PointGridDoubleClick" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="顺序" Binding="{Binding Number}" Width="75"/>
       <DataGridTemplateColumn Header="屏幕位置" Width="*" MinWidth="195"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="X" Foreground="#98A1B0" Margin="0,0,8,0"/><TextBlock Text="{Binding X}" FontFamily="Consolas" MinWidth="64"/><TextBlock Text="Y" Foreground="#98A1B0" Margin="12,0,8,0"/><TextBlock Text="{Binding Y}" FontFamily="Consolas"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="鼠标按键" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#F0F3F8" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left"><TextBlock Text="{Binding ButtonText}" FontSize="12"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="点击后等待" Binding="{Binding DelayText}" Width="180"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,0" IsHitTestVisible="False">
      <TextBlock Text="＋" FontSize="28" Foreground="#B5C5EC" HorizontalAlignment="Center"/>
      <TextBlock Text="还没有点击位置" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,6"/>
      <TextBlock Text="点击“添加位置”，在屏幕上选取第一个目标" Foreground="{StaticResource Muted}" FontSize="12"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="3" Background="#FBFCFE" BorderBrush="#EDF0F5" BorderThickness="0,1,0,0" Padding="20,10" CornerRadius="0,0,12,12"><TextBlock Text="每个位置独立等待；最后一个位置等待结束后，回到第一个位置。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="12" Padding="20,16">
    <StackPanel x:Name="ConfigPanel">
     <TextBlock Text="停止条件" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,9"/>
     <StackPanel Orientation="Horizontal"><RadioButton x:Name="UnlimitedRadio" GroupName="StopMode" Content="持续点击" IsChecked="True" Checked="ConfigurationChanged"/><TextBlock Text="直到手动停止" Foreground="{StaticResource Muted}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,6,0,13"><RadioButton x:Name="LimitedRadio" GroupName="StopMode" Content="指定总次数" Checked="ConfigurationChanged"/><TextBox x:Name="LimitBox" Width="104" Text="100" Margin="14,0,7,0" IsEnabled="False" LostFocus="LimitLostFocus" AutomationProperties.Name="指定点击总次数"/><TextBlock Text="次后停止" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
     <CheckBox x:Name="MinimizeCheck" Content="开始后最小化，避免遮挡目标" IsChecked="True" FontSize="12" Foreground="#69768A" Checked="ConfigurationChanged" Unchecked="ConfigurationChanged"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="12" Padding="20,16">
    <StackPanel><TextBlock Text="运行记录" FontSize="14" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,6"><TextBlock x:Name="ExecutedCountText" Text="0" FontSize="35" FontWeight="SemiBold" FontFamily="Segoe UI"/><TextBlock Text="次点击" Foreground="{StaticResource Muted}" FontSize="12" Margin="9,0,0,8" VerticalAlignment="Bottom"/></StackPanel><TextBlock x:Name="CurrentPointText" Text="尚未开始" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="按实际点击总数累计，不按循环轮数" Foreground="#9AA3B2" FontSize="11" Margin="0,8,0,0"/></StackPanel>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3">
   <Border x:Name="NoticeBorder" Visibility="Collapsed" Background="#FFF4E6" CornerRadius="7" Padding="11,8" Margin="0,0,0,10"><TextBlock x:Name="NoticeText" Foreground="#8D632C" TextWrapping="Wrap" FontSize="12"/></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="StartButton" Content="▶   开始点击" Style="{StaticResource PrimaryButton}" Width="174" Height="45" FontSize="14" Click="StartStopClick"/>
    <Button x:Name="EmergencyButton" Grid.Column="1" Content="■  紧急停止" Style="{StaticResource DangerButton}" Height="45" Margin="10,0,0,0" Click="EmergencyStopClick" IsEnabled="False"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="HotkeySummary" Text="F6 启停  /  F8 紧停" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/><Button x:Name="HotkeyButton" Content="修改快捷键" FontSize="12" Margin="12,0,0,0" BorderThickness="0" Background="Transparent" Padding="8,7" Click="HotkeySettingsClick"/></StackPanel>
   </Grid>
   <TextBlock Text="运行时手动快速双击左键可停止  ·  设置自动保存  ·  v1.0" FontSize="11" Foreground="#8B96A8" Margin="0,12,0,0"/>
  </StackPanel>
 </Grid>
</Window>
